container1-backend/service_account.json


# -------------------------------------------------------------------
# Dipendenze e Cache del Backend (Python)
# -------------------------------------------------------------------

# Cartella della cache di Python
__pycache__/

# File Python compilati
*.pyc

# Cartelle di ambienti virtuali
.env
.venv
env/
venv/
ENV/
VENV/

# Cartella per i video caricati (temporanei)
container1-backend/uploads/

# Cache della libreria Towhee (può contenere modelli pesanti)
.towhee/


# -------------------------------------------------------------------
# Dipendenze e Artefatti del Frontend (Node.js / React)
# -------------------------------------------------------------------

# La cartella delle dipendenze di Node.js (può essere enorme)
container1-frontend/node_modules/

# La cartella di build di produzione
container1-frontend/build/

# File di log
container1-frontend/npm-debug.log*
container1-frontend/yarn-debug.log*
container1-frontend/yarn-error.log*

# File di ambiente locale (spesso contengono chiavi API)
container1-frontend/.env.local
container1-frontend/.env.development.local
container1-frontend/.env.test.local
container1-frontend/.env.production.local


